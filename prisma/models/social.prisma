// Social Module Models - Comments, Replies, Likes, and Settings

model Comment {
  id         String   @id @default(cuid())
  content    String   @db.Text
  userId     String
  targetType String // "blog", "page", "product"
  targetId   String
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  replies Reply[]

  @@index([targetType, targetId])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model Reply {
  id        String   @id @default(cuid())
  content   String   @db.Text
  userId    String
  commentId String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model Like {
  id         String   @id @default(cuid())
  userId     String
  targetType String // "blog", "page", "product"
  targetId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}
