// Commerce Models

model Product {
  id              String          @id @default(cuid())
  name            String
  description     String?         @db.Text
  content         String?         @db.Text // Rich text content for product details
  image           String?
  slug            String          @unique
  price           Int             // Price in cents
  currency        String          @default("usd")
  quantity        Int?            // Stock quantity, null means unlimited
  isActive        Boolean         @default(true)
  metadata        String?         @db.Text // JSON string for additional data
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  paymentMethods  PaymentMethod[]
  orders          Order[]

  @@index([slug])
  @@index([isActive])
}

model PaymentMethod {
  id              String    @id @default(cuid())
  productId       String
  
  // Payment provider: stripe or paypal
  provider        String    // stripe, paypal
  
  // Stripe fields
  stripePriceId   String?   @unique
  stripeProductId String?
  
  // PayPal fields
  paypalPlanId    String?   @unique
  paypalProductId String?
  
  mode            String    @default("payment") // payment or subscription
  interval        String?   // For subscriptions: day, week, month, year
  intervalCount   Int?      // For subscriptions: billing cycle count
  isActive        Boolean   @default(true)
  metadata        String?   @db.Text // JSON string for additional data
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([provider])
  @@index([isActive])
  @@index([mode])
}

model Order {
  id                String    @id @default(cuid())
  userId            String?
  productId         String
  paymentMethodId   String?   // Reference to the payment method used
  
  // Payment provider: stripe or paypal
  paymentProvider   String    @default("stripe") // stripe, paypal
  
  // Stripe fields
  stripeSessionId   String?   @unique
  stripeCustomerId  String?
  
  // PayPal fields
  paypalOrderId     String?   @unique
  paypalSubscriptionId String? @unique
  
  status            String    @default("pending") // pending, completed, failed, refunded, expired
  amount            Int       // Amount in cents
  currency          String    @default("usd")
  metadata          String?   @db.Text // JSON string
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  product           Product   @relation(fields: [productId], references: [id])
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([paymentMethodId])
  @@index([status])
  @@index([paymentProvider])
  @@index([createdAt])
}
