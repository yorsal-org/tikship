# Database
## Database Providers: mysql, postgresql, sqlite
## MySQL: mysql://USER:PASSWORD@HOST:PORT/DATABASE
## PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
## SQLite: file:./dev.db
DATABASE_URL="postgresql://databasename@localhost:5432/tikship?schema=public"

# NextAuth
## NEXTAUTH_SECRET key is genereated by yourself
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-own-secret-key"

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-auth-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Github OAuth (https://github.com/settings/developers)
GITHUB_ID="your-github-id"
GITHUB_SECRET="your-github-secret"


# Email Service (mailgun or resend)
EMAIL_PROVIDER="mailgun"

# Mailgun
## Get your API key from: https://app.mailgun.com/app/account/security/api_keys
## Get your domain from: https://app.mailgun.com/app/sending/domains
MAILGUN_API_KEY="your-mailgun-api-key"
MAILGUN_DOMAIN="your-domain.com"
MAILGUN_FROM_EMAIL="noreply@your-domain.com"

# Resend
## Get your API key from: https://resend.com
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="noreply@your-domain.com"

# Upload Service (local or imgbb)
UPLOAD_PROVIDER="imgbb"
## Get your API key from: https://imgbb.com
IMGBB_API_KEY="your-imgbb-api-key"

# Stripe payment service
## Get your API keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_SUCCESS_URL="{your domain}/payment/success"
STRIPE_CANCEL_URL="{your domain}/payment/cancel"

# PayPal payment service
## Get your API keys from https://developer.paypal.com/dashboard
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_WEBHOOK_ID="your-paypal-webhook-id"

# Admin Account (for database seeding)
## These credentials will be used to create the first superuser account
ADMIN_USERNAME="tikship"
ADMIN_EMAIL="tikship@example.com"

# Themes
## Default theme mode: 'light', 'dark', or 'system'
NEXT_PUBLIC_SYSTEM_THEME="system"
## DaisyUI light theme name
NEXT_PUBLIC_LIGHT_THEME="silk"
## DaisyUI light theme name
NEXT_PUBLIC_DARK_THEME="sunset"

# API Docs enable or disable (keep the key empty to make it disabled)
NEXT_PUBLIC_ENABLE_API_DOCS="1"

# Admin path (change to hide the admin management path)
NEXT_PUBLIC_ADMIN_PATH="/admin"

